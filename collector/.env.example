# Copy this file to collector/.env and fill it in. Never commit .env.

# Your IQ Gateway on the home network (found at 192.168.1.166).
GATEWAY_HOST=192.168.1.166

# Owner token from https://entrez.enphaseenergy.com (valid ~1 year).
GATEWAY_TOKEN=

# Filled in after the dashboard is deployed to Vercel.
INGEST_URL=https://YOUR-APP.vercel.app/api/ingest
INGEST_SECRET=

INTERVAL_SECONDS=60

# Home Assistant long-lived access token (Profile > Security), optional
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Dad's briefing: a local Ollama model explains the dashboard in plain English (optional)
OLLAMA_MODEL=gemma3:4b
OLLAMA_URL=http://localhost:11434
BRIEFING_HOURS=6
